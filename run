#!/bin/bash

# Simple wrapper script around the Reports bot task runner. Assumes a venv has
# been created (see README.md).
#
# To run a task located at 'tasks/foobar.py':
#   ./run foobar
#
# For detailed command-line arguments:
#   ./run --help

set -euo pipefail

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

export REPORTS_BOT_TASKS_DIR="$SCRIPT_DIR"/tasks
export REPORTS_BOT_CONFIG_DIR="$SCRIPT_DIR"/config
export REPORTS_BOT_LOGS_DIR="$SCRIPT_DIR"/logs

export PYWIKIBOT2_DIR=$REPORTS_BOT_CONFIG_DIR

. "$SCRIPT_DIR"/venv/bin/activate
exec python -m reportsbot.cli "$@"
